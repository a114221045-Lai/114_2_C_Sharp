using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Food_Facts
{
    /// <summary>
    /// FoodItem 類：代表一個食物項目
    /// 用於存儲食物的各種營養信息，包括名稱、熱量、脂肪和碳水化合物
    /// </summary>
    public class FoodItem
    {
        private string name;
        private string calories;
        private string fat;
        private string carbs;
        /// <summary>
        /// 食物名稱
        /// </summary>
        public string Name
        {
            get { return name; }
            set { name = value; }
        }

        /// <summary>
        /// 食物的熱量
        /// </summary>
        public string Calories
        {
            get { return calories; }
            set { calories = value; }
        }

        /// <summary>
        /// 食物的脂肪克數
        /// </summary>
        public string Fat
        {
            get { return fat; }
            set { fat = value; }
        }

        /// <summary>
        /// 食物的碳水化合物克數
        /// </summary>
        public string Carbs
        {
            get { return carbs; }
            set { carbs = value; }
        }

        /// <summary>
        /// FoodItem 構造函數
        /// 初始化一個新的食物項目實例
        /// </summary>
        /// <param name="name">食物名稱</param>
        /// <param name="calories">熱量</param>
        /// <param name="fat">脂肪克數</param>
        /// <param name="carbs">碳水化合物克數</param>
        public FoodItem(string name, string calories, string fat, string carbs)
        {
            this.name = name;
            this.calories = calories;
            this.fat = fat;
            this.carbs = carbs;
        }
    }
}


