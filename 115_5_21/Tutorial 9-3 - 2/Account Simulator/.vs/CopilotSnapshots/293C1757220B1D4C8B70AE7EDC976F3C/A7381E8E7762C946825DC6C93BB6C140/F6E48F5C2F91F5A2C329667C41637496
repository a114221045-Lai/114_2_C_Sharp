using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;

namespace Account_Simulator
{
    public partial class Form1 : Form
    {
        private BankAccount account;

        class BankAccount// 存儲帳戶餘額的私有欄位
        {
            private decimal balance;
            private string name;
            private string accountNumber;

            public BankAccount(string name, string accountNumber, decimal initialBalance)
            {
                this.name = name;
                this.accountNumber = accountNumber;
                balance = initialBalance;
            }
            public BankAccount(decimal initialBalance)
            {
                balance = initialBalance;
            }
            public void Deposit(decimal amount)
            {
                if (amount <= 0)
                    return;
                balance += amount;
            }
            public bool Withdraw(decimal amount)
            {
                if (amount > 0 && amount <= balance)
                {
                    balance -= amount;
                    return true;
                }
                return false;
            }
            public decimal GetBalance()
            {
                return balance;
            }
        }

        public Form1()
        {
            InitializeComponent();
        }

        private void Form1_Load(object sender, EventArgs e)
        {
            // 建立新的銀行帳戶物件，初始餘額為 10000
            account = new BankAccount(10000);
            
            // 在餘額標籤中顯示起始餘額
            //balanceLabel.Text = account.GetBalance().ToString("C");
        }

        private void depositButton_Click(object sender, EventArgs e)
        {
            // 嘗試解析使用者輸入的存入金額
            if (decimal.TryParse(depositTextBox.Text, out decimal amount))
            {
                // 呼叫帳戶物件的存入方法，傳入金額
                account.Deposit(amount);
                
                // 更新餘額標籤以顯示新的餘額
                balanceLabel.Text = account.GetBalance().ToString("C");
                
                // 清空存入金額文字方塊
                depositTextBox.Text = "";
            }
            else
            {
                // 若輸入無效，顯示錯誤訊息
                MessageBox.Show("請輸入有效的金額");
                depositTextBox.Clear();
            }
        }

        private void withdrawButton_Click(object sender, EventArgs e)
        {
            decimal amount;
            // 嘗試解析使用者輸入的提取金額
            if (decimal.TryParse(withdrawTextBox.Text, out amount))
            {
                // 呼叫帳戶物件的提取方法，傳入金額，並檢查是否提取成功
                if (account.Withdraw(amount))
                {
                    // 提取成功，更新餘額標籤以顯示新的餘額
                    balanceLabel.Text = account.GetBalance().ToString("C");
                    
                    // 清空提取金額文字方塊
                    withdrawTextBox.Text = "";
                }
                else
                {
                    // 提取金額不足，顯示錯誤訊息
                    MessageBox.Show("提取金額不足！餘額不足以完成此筆交易。");
                    withdrawTextBox.Clear();
                }
            }
            else
            {
                // 若輸入無效，顯示錯誤訊息
                MessageBox.Show("請輸入有效的金額");
                withdrawTextBox.Clear();
            }
        }

        private void exitButton_Click(object sender, EventArgs e)
        {
            // 關閉表單
            this.Close();
        }
    }
}
